# Optional LLM-assisted Dockerfile patching
ANTHROPIC_API_KEY=

# Render cloud deployment credentials (never commit real values)
RENDER_API_KEY=
RENDER_OWNER_ID=
GITHUB_TOKEN=

# Reliability/security settings
MAX_DEPLOY_ATTEMPTS=6
# Only set true after manually reviewing secret scanner findings; public repo risk!
ALLOW_PUBLIC_DEPLOY_WITH_FINDINGS=false
